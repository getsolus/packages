From f14b340f48550a508a37e5aba32f43f3266a01ca Mon Sep 17 00:00:00 2001
From: Joey Riches <josephriches@gmail.com>
Date: Tue, 6 Oct 2026 21:54:21 +0100
Subject: [PATCH 1/1] data: Remove duplicate desktop-id launchable in appstream
 metainfo

Since appstream >= 1.2.x having multiple desktop-ids will cause
appstream composition to fail.
---
 data/org.gnome.Characters.metainfo.xml.in.in | 1 -
 1 file changed, 1 deletion(-)

diff --git a/data/org.gnome.Characters.metainfo.xml.in.in b/data/org.gnome.Characters.metainfo.xml.in.in
index cbc4761..f869aa5 100644
--- a/data/org.gnome.Characters.metainfo.xml.in.in
+++ b/data/org.gnome.Characters.metainfo.xml.in.in
@@ -46,7 +46,6 @@
     <display_length>360</display_length>
   </requires>
   <translation type="gettext">org.gnome.Characters</translation>
-  <launchable type="desktop-id">org.gnome.Characters.desktop</launchable>
   <content_rating type="oars-1.1"/>
   <branding>
     <color type="primary" scheme_preference="light">#f9f06b</color>
-- 
2.56.0

