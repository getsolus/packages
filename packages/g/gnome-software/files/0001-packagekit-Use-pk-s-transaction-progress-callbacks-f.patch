From 96f89f6d6ed158c4739bb6902cf24c02fa58be18 Mon Sep 17 00:00:00 2001
From: Joey Riches <josephriches@gmail.com>
Date: Sun, 8 Nov 2026 17:24:18 +0000
Subject: [PATCH 1/1] packagekit: Use pk's transaction progress callbacks for
 reporting

Previously, G-S attempted to implicitly attribute progress per-app to
report progress updates. However, this does not work for internally
parallelized packagekit backends which may download concurrently or
install dependencies in parallel.

Let's just rely on the progress callbacks from packagekit instead which
provides the aggregated transactional value.
---
 lib/gs-plugin-job-update-apps.c           | 13 +++++++++
 plugins/packagekit/gs-packagekit-helper.c | 31 ++++++++++++++++++--
 plugins/packagekit/gs-packagekit-helper.h |  6 +++-
 plugins/packagekit/gs-plugin-packagekit.c | 35 ++++++++++++++++++++---
 4 files changed, 78 insertions(+), 7 deletions(-)

diff --git a/lib/gs-plugin-job-update-apps.c b/lib/gs-plugin-job-update-apps.c
index b5efbf37f..9dc6336a5 100644
--- a/lib/gs-plugin-job-update-apps.c
+++ b/lib/gs-plugin-job-update-apps.c
@@ -364,6 +364,14 @@ progress_cb (gpointer user_data)
 		 * download operation is blocked on waiting for metered data permission
 		 * to download, so the UI can represent that better. */
 		g_signal_emit (self, signals[SIGNAL_PROGRESS], 0, (guint) progress);
+
+		/* Plugins are only given a filtered copy of the app list, so an
+		 * overall progress value applied to their copy would not reach the
+		 * caller. An aggregate value cannot be attributed to any one app,
+		 * so mirror it onto the original list for download-only jobs. */
+		if ((self->flags & GS_PLUGIN_UPDATE_APPS_FLAGS_NO_APPLY) != 0)
+			gs_app_list_override_progress (self->apps, (guint) progress);
+
 		self->last_reported_progress = progress;
 	}
 
@@ -447,6 +455,11 @@ finish_op (GTask  *task,
 		progress_cb (self);
 	}
 
+	/* Drop any overall progress override so that subsequent operations can
+	 * report per-app progress again. */
+	if ((self->flags & GS_PLUGIN_UPDATE_APPS_FLAGS_NO_APPLY) != 0)
+		gs_app_list_override_progress (self->apps, GS_APP_PROGRESS_UNKNOWN);
+
 	g_source_destroy (self->progress_source);
 	g_clear_pointer (&self->plugins_progress, g_hash_table_unref);
 
diff --git a/plugins/packagekit/gs-packagekit-helper.c b/plugins/packagekit/gs-packagekit-helper.c
index da36c8f89..9c44cf8a0 100644
--- a/plugins/packagekit/gs-packagekit-helper.c
+++ b/plugins/packagekit/gs-packagekit-helper.c
@@ -22,6 +22,9 @@ struct _GsPackagekitHelper {
 
 	GsApp			*progress_app;  /* (owned) (nullable) */
 	GsAppList		*progress_list;  /* (owned) (nullable) */
+	gboolean		 progress_list_updates_apps;
+	GsPluginProgressCallback progress_callback;  /* (nullable) */
+	gpointer		 progress_user_data;
 	GsPlugin		*plugin;  /* (owned) (not nullable) */
 	gboolean		 allow_emit_updates_changed;
 };
@@ -80,8 +83,18 @@ gs_packagekit_helper_cb (PkProgress *progress, PkProgressType type, gpointer use
 		gint percentage = pk_progress_get_percentage (progress);
 		if (app != NULL && percentage >= 0 && percentage <= 100)
 			gs_app_set_progress (app, (guint) percentage);
-		if (self->progress_list != NULL && percentage >= 0 && percentage <= 100)
+		if (self->progress_list != NULL && percentage >= 0 && percentage <= 100) {
 			gs_app_list_override_progress (self->progress_list, (guint) percentage);
+
+			if (self->progress_list_updates_apps) {
+				for (guint i = 0; i < gs_app_list_length (self->progress_list); i++) {
+					GsApp *app_tmp = gs_app_list_index (self->progress_list, i);
+					gs_app_set_progress (app_tmp, (guint) percentage);
+				}
+			}
+		}
+		if (self->progress_callback != NULL && percentage >= 0 && percentage <= 100)
+			self->progress_callback (plugin, (guint) percentage, self->progress_user_data);
 	}
 
 	/* Only go from TRUE to FALSE - it doesn't make sense for a package
@@ -116,12 +129,26 @@ gs_packagekit_helper_set_progress_app (GsPackagekitHelper *self, GsApp *progress
 }
 
 void
-gs_packagekit_helper_set_progress_list (GsPackagekitHelper *self, GsAppList *progress_list)
+gs_packagekit_helper_set_progress_list (GsPackagekitHelper *self,
+					 GsAppList *progress_list,
+					 gboolean update_apps)
 {
 	g_return_if_fail (GS_IS_PACKAGEKIT_HELPER (self));
 	g_return_if_fail (progress_list == NULL || GS_IS_APP_LIST (progress_list));
 
 	g_set_object (&self->progress_list, progress_list);
+	self->progress_list_updates_apps = update_apps;
+}
+
+void
+gs_packagekit_helper_set_progress_callback (GsPackagekitHelper       *self,
+					     GsPluginProgressCallback  progress_callback,
+					     gpointer                  progress_user_data)
+{
+	g_return_if_fail (GS_IS_PACKAGEKIT_HELPER (self));
+
+	self->progress_callback = progress_callback;
+	self->progress_user_data = progress_user_data;
 }
 
