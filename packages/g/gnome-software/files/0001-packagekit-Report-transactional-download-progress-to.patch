From d611dd47b5130e233b1ce34a033fcce63b42b7cf Mon Sep 17 00:00:00 2001
From: Joey Riches <josephriches@gmail.com>
Date: Sun, 8 Nov 2026 17:24:18 +0000
Subject: [PATCH 1/2] packagekit: Report transactional download progress to
 update job

G-S implicitly attempts to attribute download progress  per-package;
internally parallelized PK backends will report an aggregate
transactional value that cannot be mapped to a single package.

As Plugins only receive a filtered copy of the app list, applying the
override to the plugin's list never reached the Updates section and left
its global progress bar unknown.
---
 plugins/packagekit/gs-packagekit-helper.c | 19 +++++++++++++++++++
 plugins/packagekit/gs-packagekit-helper.h |  3 +++
 plugins/packagekit/gs-plugin-packagekit.c | 14 +++++++++++++-
 3 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/plugins/packagekit/gs-packagekit-helper.c b/plugins/packagekit/gs-packagekit-helper.c
index da36c8f89..a94a701a4 100644
--- a/plugins/packagekit/gs-packagekit-helper.c
+++ b/plugins/packagekit/gs-packagekit-helper.c
@@ -22,6 +22,8 @@ struct _GsPackagekitHelper {
 
 	GsApp			*progress_app;  /* (owned) (nullable) */
 	GsAppList		*progress_list;  /* (owned) (nullable) */
+	GsPluginProgressCallback progress_callback;  /* (nullable) */
+	gpointer		 progress_user_data;
 	GsPlugin		*plugin;  /* (owned) (not nullable) */
 	gboolean		 allow_emit_updates_changed;
 };
@@ -82,6 +84,12 @@ gs_packagekit_helper_cb (PkProgress *progress, PkProgressType type, gpointer use
 			gs_app_set_progress (app, (guint) percentage);
 		if (self->progress_list != NULL && percentage >= 0 && percentage <= 100)
 			gs_app_list_override_progress (self->progress_list, (guint) percentage);
+		/* Forward the transaction-wide percentage even if it cannot be
+		 * attributed to a specific app. Some backends report a single
+		 * aggregate value for the whole transaction rather than per-app
+		 * progress. */
+		if (self->progress_callback != NULL && percentage >= 0 && percentage <= 100)
+			self->progress_callback (plugin, (guint) percentage, self->progress_user_data);
 	}
 
 	/* Only go from TRUE to FALSE - it doesn't make sense for a package
@@ -124,6 +132,17 @@ gs_packagekit_helper_set_progress_list (GsPackagekitHelper *self, GsAppList *pro
 	g_set_object (&self->progress_list, progress_list);
 }
 
+void
+gs_packagekit_helper_set_progress_callback (GsPackagekitHelper       *self,
+					     GsPluginProgressCallback  progress_callback,
+					     gpointer                  progress_user_data)
+{
+	g_return_if_fail (GS_IS_PACKAGEKIT_HELPER (self));
+
+	self->progress_callback = progress_callback;
+	self->progress_user_data = progress_user_data;
+}
+
 /*
  * gs_packagekit_helper_set_allow_emit_updates_changed:
  * @self: a #GsPackagekitHelper
diff --git a/plugins/packagekit/gs-packagekit-helper.h b/plugins/packagekit/gs-packagekit-helper.h
index 1620a0bfa..f2c05b638 100644
--- a/plugins/packagekit/gs-packagekit-helper.h
+++ b/plugins/packagekit/gs-packagekit-helper.h
@@ -27,6 +27,9 @@ void		 gs_packagekit_helper_set_progress_app	(GsPackagekitHelper	*self,
 							 GsApp			*progress_app);
 void		 gs_packagekit_helper_set_progress_list	(GsPackagekitHelper	*self,
 							 GsAppList		*progress_list);
+void		 gs_packagekit_helper_set_progress_callback	(GsPackagekitHelper	*self,
+							 GsPluginProgressCallback progress_callback,
+							 gpointer		 progress_user_data);
 void		 gs_packagekit_helper_set_allow_emit_updates_changed
 							(GsPackagekitHelper	*self,
 							 gboolean		 allow_emit_updates_changed);
diff --git a/plugins/packagekit/gs-plugin-packagekit.c b/plugins/packagekit/gs-plugin-packagekit.c
index a208904bc..ab461d1a7 100644
--- a/plugins/packagekit/gs-plugin-packagekit.c
+++ b/plugins/packagekit/gs-plugin-packagekit.c
@@ -3185,6 +3185,8 @@ gs_plugin_packagekit_refine_add_history (GsApp *app, GVariant *dict)
 static void gs_plugin_packagekit_download_async (GsPluginPackagekit    *self,
                                                  GsAppList             *list,
                                                  gboolean               interactive,
+                                                 GsPluginProgressCallback progress_callback,
+                                                 gpointer               progress_user_data,
                                                  GsPluginEventCallback  event_callback,
                                                  void                  *event_user_data,
                                                  GCancellable          *cancellable,
@@ -3275,6 +3277,7 @@ prepare_update_get_updates_cb (GObject      *source_object,
 
 	/* It’s OK to call this with an empty list; it’ll return immediately */
 	gs_plugin_packagekit_download_async (self, list, interactive,
+					     NULL, NULL,
 					     prepare_update_event_cb, NULL,
 					     cancellable,
 					     prepare_update_download_cb, g_steal_pointer (&task));
@@ -4751,6 +4754,8 @@ typedef struct {
 	GsAppList *progress_list;  /* (owned) */
 
 	gboolean interactive;
+	GsPluginProgressCallback progress_callback;
+	gpointer progress_user_data;
 	GsPluginEventCallback event_callback;
 	void *event_user_data;
 
@@ -4788,6 +4793,8 @@ static void
 gs_plugin_packagekit_download_async (GsPluginPackagekit    *self,
                                      GsAppList             *list,
                                      gboolean               interactive,
+                                     GsPluginProgressCallback progress_callback,
+                                     gpointer               progress_user_data,
                                      GsPluginEventCallback  event_callback,
                                      void                  *event_user_data,
                                      GCancellable          *cancellable,
@@ -4806,6 +4813,8 @@ gs_plugin_packagekit_download_async (GsPluginPackagekit    *self,
 	data->download_list = gs_app_list_new ();
 	data->progress_list = g_object_ref (list);
 	data->interactive = interactive;
+	data->progress_callback = progress_callback;
+	data->progress_user_data = progress_user_data;
 	data->event_callback = event_callback;
 	data->event_user_data = event_user_data;
 	data->helper = gs_packagekit_helper_new (plugin);
@@ -4955,6 +4964,9 @@ download_get_updates_cb (GObject      *source_object,
 		gs_packagekit_helper_add_app (data->helper, app);
 	}
 	gs_packagekit_helper_set_progress_list (data->helper, data->progress_list);
+	gs_packagekit_helper_set_progress_callback (data->helper,
+						    data->progress_callback,
+						    data->progress_user_data);
 
 	/* make 'download' operation always low priority, so other interactive
 	   operations get to run when a download is in progress */
@@ -5082,8 +5094,8 @@ gs_plugin_packagekit_update_apps_async (GsPlugin                           *plug
 	g_task_set_source_tag (task, gs_plugin_packagekit_update_apps_async);
 
 	if (!(flags & GS_PLUGIN_UPDATE_APPS_FLAGS_NO_DOWNLOAD)) {
-		/* FIXME: Add progress reporting */
 		gs_plugin_packagekit_download_async (self, apps, interactive,
+						     progress_callback, progress_user_data,
 						     event_callback, event_user_data,
 						     cancellable, update_apps_download_cb, g_steal_pointer (&task));
 	} else {
