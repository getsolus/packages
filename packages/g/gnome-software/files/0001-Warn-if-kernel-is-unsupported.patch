+
                             <child>
                               <object class="AdwClamp">
                                 <property name="maximum-size">860</property>
diff --git a/src/gs-summary-tile.c b/src/gs-summary-tile.c
index 084c8ac9c..914b236d0 100644
--- a/src/gs-summary-tile.c
+++ b/src/gs-summary-tile.c
@@ -93,6 +93,7 @@ gs_summary_tile_refresh (GsAppTile *self)
 	GsApp *app = gs_app_tile_get_app (self);
 	gboolean installed;
 	gboolean matches_hardware;
+	gboolean unsupported_kernel;
 	g_autofree gchar *name = NULL;
 	const gchar *summary;
 
@@ -176,6 +177,19 @@ gs_summary_tile_refresh (GsAppTile *self)
 	gtk_widget_set_tooltip_text (tile->matches_hardware_icon,
 				     matches_hardware ? _("Known to support your system") : NULL);
 
+	/*
+	 * Show unsupported kernel apps as gray monotone tiles. Some distros support co-installable
+	 * kernel flavours so avoid hiding them entirely.
+	 */
+	unsupported_kernel = !installed && gs_app_has_quirk (app, GS_APP_QUIRK_UNSUPPORTED_KERNEL);
+	if (unsupported_kernel) {
+		gtk_widget_add_css_class (GTK_WIDGET (tile), "unsupported-kernel");
+	} else {
+		gtk_widget_remove_css_class (GTK_WIDGET (tile), "unsupported-kernel");
+	}
+	gtk_widget_set_tooltip_text (GTK_WIDGET (tile),
+				     unsupported_kernel ? _("Not supported on the running kernel") : NULL);
+
 	if (name != NULL) {
 		gtk_accessible_update_property (GTK_ACCESSIBLE (tile),
 						GTK_ACCESSIBLE_PROPERTY_LABEL, name,
