+                                    <child>
+                                      <object class="GtkLabel" id="label_kernel_unsupported">
+                                        <property name="justify">center</property>
+                                        <property name="label"><!-- filled in the code --></property>
+                                        <property name="wrap">True</property>
+                                      </object>
+                                    </child>
+                                    <style>
+                                      <class name="card"/>
+                                      <class name="warning"/>
+                                      <class name="infobox"/>
+                                    </style>
