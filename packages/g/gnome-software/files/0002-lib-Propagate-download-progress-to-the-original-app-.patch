From 58be3ef06c3f3110a72737991840b91dff93c80f Mon Sep 17 00:00:00 2001
From: Joey Riches <josephriches@gmail.com>
Date: Sun, 8 Nov 2026 17:22:44 +0000
Subject: [PATCH 2/2] lib: Propagate download progress to the original app list

---
 lib/gs-plugin-job-update-apps.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/lib/gs-plugin-job-update-apps.c b/lib/gs-plugin-job-update-apps.c
index b5efbf37f..9dc6336a5 100644
--- a/lib/gs-plugin-job-update-apps.c
+++ b/lib/gs-plugin-job-update-apps.c
@@ -364,6 +364,14 @@ progress_cb (gpointer user_data)
 		 * download operation is blocked on waiting for metered data permission
 		 * to download, so the UI can represent that better. */
 		g_signal_emit (self, signals[SIGNAL_PROGRESS], 0, (guint) progress);
+
+		/* Plugins are only given a filtered copy of the app list, so an
+		 * overall progress value applied to their copy would not reach the
+		 * caller. An aggregate value cannot be attributed to any one app,
+		 * so mirror it onto the original list for download-only jobs. */
+		if ((self->flags & GS_PLUGIN_UPDATE_APPS_FLAGS_NO_APPLY) != 0)
+			gs_app_list_override_progress (self->apps, (guint) progress);
+
 		self->last_reported_progress = progress;
 	}
 
@@ -447,6 +455,11 @@ finish_op (GTask  *task,
 		progress_cb (self);
 	}
 
+	/* Drop any overall progress override so that subsequent operations can
+	 * report per-app progress again. */
+	if ((self->flags & GS_PLUGIN_UPDATE_APPS_FLAGS_NO_APPLY) != 0)
+		gs_app_list_override_progress (self->apps, GS_APP_PROGRESS_UNKNOWN);
+
 	g_source_destroy (self->progress_source);
 	g_clear_pointer (&self->plugins_progress, g_hash_table_unref);
 
