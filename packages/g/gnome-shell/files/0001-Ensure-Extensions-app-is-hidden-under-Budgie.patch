From: Joshua Strobl <joshua@streambits.io>
Date: Wed, 30 Sep 2026 16:53:03 +0100
Subject: [PATCH 1/1] Ensure Extensions app is hidden under Budgie

---
 data/org.gnome.Shell.Extensions.desktop.in | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/data/org.gnome.Shell.Extensions.desktop.in b/data/org.gnome.Shell.Extensions.desktop.in
index 759d8cafb..790c64019 100644
--- a/data/org.gnome.Shell.Extensions.desktop.in
+++ b/data/org.gnome.Shell.Extensions.desktop.in
@@ -7,4 +7,6 @@ Icon=org.gnome.Shell.Extensions
 # Never launch this, just provide name+icon to portal dialog
 Exec=false
 OnlyShowIn=GNOME;
+# Budgie reports as Budgie:GNOME for session and WM compatibility reasons
++NotShowIn=Budgie:GNOME;
 NoDisplay=true
