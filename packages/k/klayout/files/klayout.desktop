[Desktop Entry]
Version=1.0
Name=Klayout, viewer and editor of mask layouts.
GenericName=layout viewer
Comment=Klayout is a viewer (and editor) of mask layout in a.o. GDSII and CIF format.
Exec=klayout %f
Icon=klayout
Type=Application
Categories=Development;Engineering;Electronics;
Actions=Editor;Viewer;

[Desktop Action Editor]
Name=Klayout Editor
Name[de]=Klayout Editor
Name[zh_CN]=Klayout编辑器
GenericName=Klayout Editor
GenericName[de]=Klayout Editor
GenericName[zh_CN]=Klayout编辑器
Comment=Program to edit GDS-Files
Comment[de]=Programm zur Bearbeiten von GDS-Dateien
Comment[zh_CN]=GDS版图文件编辑软件
Exec=klayout -e %F
Icon=klayout
StartupNotify=true
Terminal=false

[Desktop Action Viewer]
Name=Klayout Viewer
Name[de]=Klayout Viewer
Name[zh_CN]=Klayout查看器
GenericName=Klayout Viewer
GenericName[de]=Klayout Viewer
GenericName[zh_CN]=Klayout查看器
Comment=Program to view GDS-Files
Comment[de]=Programm zur Betrachten von GDS-Dateien
Comment[zh_CN]=GDS版图文件查看软件
Exec=klayout -ne %F
Icon=klayout
StartupNotify=true
Terminal=false
