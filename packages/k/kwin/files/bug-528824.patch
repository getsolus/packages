From 19404161bc367b87b794361915b85a14c034ec63 Mon Sep 17 00:00:00 2001
From: Xaver Hugl <xaver.hugl@kde.org>
Date: Tue, 17 Nov 2026 10:37:29 +0100
Subject: [PATCH] input: only init backends after InputRedirection

And more importantly, after the input redirection global has been set.
Doing it in the constructor means that input backends potentially sending
events during their initialization, where code may access the input direction
and crash if it's not a valid pointer yet.

This should fix https://crash-reports.kde.org/organizations/kde/share/issue/5b82c563178f416d9756b730bb226735/

BUG: 528824


(cherry picked from commit a96ceac71f3948b165e152dfc78aa964677e20aa)

Co-authored-by: Xaver Hugl <xaver.hugl@kde.org>
---
 src/input.cpp | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/src/input.cpp b/src/input.cpp
index 327e713bc32..76e082954ab 100644
--- a/src/input.cpp
+++ b/src/input.cpp
@@ -2935,8 +2935,6 @@ InputRedirection::InputRedirection(QObject *parent)
     , m_shortcuts(new GlobalShortcutsManager(this))
 #endif
 {
-    setupInputBackends();
-
     connect(kwinApp(), &Application::workspaceCreated, this, &InputRedirection::setupWorkspace);
 }
 
@@ -2983,6 +2981,7 @@ void InputRedirection::init()
 #if KWIN_BUILD_GLOBALSHORTCUTS
     m_shortcuts->init();
 #endif
+    setupInputBackends();
 }
 
 void InputRedirection::setupWorkspace()
-- 
