From 955a893b27ef6bd556e894ef20dc45e0e9baa460 Mon Sep 17 00:00:00 2001
From: Xaver Hugl <xaver.hugl@kde.org>
Date: Fri, 6 Nov 2026 17:44:28 +0100
Subject: [PATCH 2/2] backends/drm: also clear non-shadowbuffer swapchain
 damage tracking

Otherwise the buffer clearing can end up not being taken into account for the
actual scene rendering.

CCBUG: 527421
---
 src/backends/drm/drm_egl_layer_surface.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/backends/drm/drm_egl_layer_surface.cpp b/src/backends/drm/drm_egl_layer_surface.cpp
index e3bbc0184b2..607a7b0efd4 100644
--- a/src/backends/drm/drm_egl_layer_surface.cpp
+++ b/src/backends/drm/drm_egl_layer_surface.cpp
@@ -459,6 +459,7 @@ std::shared_ptr<DrmFramebuffer> EglGbmLayerSurface::doRenderTestBuffer(Surface *
         if (surface->importSwapchain) {
             surface->importSwapchain->resetDamageTracking();
         }
+        surface->gbmSwapchain->resetBufferAge();
         surface->currentSlot = slot;
         surface->currentFramebuffer = ret;
         return ret;
