 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 16 ++--
 .../display/amdgpu_dm/amdgpu_dm_connector.h   |  3 +-
 .../tests/amdgpu_dm_connector_test.c          | 90 ++++++++++++++-----
 4 files changed, 89 insertions(+), 34 deletions(-)

