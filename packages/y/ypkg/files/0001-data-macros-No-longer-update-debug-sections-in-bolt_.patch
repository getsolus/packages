From 7488be6df76865e835de5503e3eb24411fcb220f Mon Sep 17 00:00:00 2001
From: Joey Riches <josephriches@gmail.com>
Date: Thu, 13 Aug 2026 19:12:33 +0100
Subject: [PATCH 1/1] data/macros: No longer update-debug-sections in bolt_opt

bolt doesn't support compressed debug symbols
---
 data/macros/actions/pgo.yaml | 1 -
 1 file changed, 1 deletion(-)

diff --git a/data/macros/actions/pgo.yaml b/data/macros/actions/pgo.yaml
index cc48bea..5a76ee6 100644
--- a/data/macros/actions/pgo.yaml
+++ b/data/macros/actions/pgo.yaml
@@ -30,7 +30,6 @@ actions:
     - bolt_opt: |
         boptim(){
             llvm-bolt ${1}.orig -o ${1}.bolt -data=$PKG_BUILD_DIR/BOLT/final/$(basename ${1}).fdata \
-                -update-debug-sections \
                 -reorder-blocks=ext-tsp \
                 -reorder-functions=hfsort+ \
                 -split-functions \
-- 
2.55.0

