From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Troy Harvey <harvey@getsol.us>
Date: Thu, 29 Oct 2026 08:25:31 +1100
Subject: [PATCH] support headless and root builds

Signed-off-by: Troy Harvey <harvey@getsol.us>
---
 build/lib/nodeCompileCache.ts | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/build/lib/nodeCompileCache.ts b/build/lib/nodeCompileCache.ts
index 66dfaf4c1b5..c41e1b281e7 100644
--- a/build/lib/nodeCompileCache.ts
+++ b/build/lib/nodeCompileCache.ts
@@ -9,7 +9,7 @@ import * as os from 'os';
 import * as path from 'path';
 
 const nodeCompileCacheKinds = ['main', 'extension-host', 'shared-process', 'pty-host', 'agent-host'] as const;
-const nodeCompileCacheTagPattern = /^v\d+\.\d+\.\d+-(arm64|x64)-[0-9a-f]{8}$/;
+const nodeCompileCacheTagPattern = /^v\d+\.\d+\.\d+-(arm64|x64)-[0-9a-f]{8}(?:-\d+)?$/;
 const nodeCompileCacheEntryPattern = /^[0-9a-f]{8}$/;
 
 export interface INodeCompileCacheProduct {
@@ -122,7 +122,11 @@ export async function validateNodeCompileCache(rootDirectory: string, architectu
 
 function runCacheGeneration(application: string, cacheDirectory: string, env: NodeJS.ProcessEnv): Promise<void> {
 	return new Promise((resolve, reject) => {
-		const child = cp.spawn(application, [], {
+		const child = cp.spawn('xvfb-run', [
+			'-a',
+			application,
+			'--no-sandbox'
+		], {
 			env,
 			stdio: ['ignore', 'pipe', 'pipe']
 		});
