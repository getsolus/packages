From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Evan Maddock <maddock.evan@vivaldi.net>
Date: Thu, 12 Nov 2026 17:01:51 -0500
Subject: [PATCH] Fix PAM dir on Solus

Signed-off-by: Evan Maddock <maddock.evan@vivaldi.net>
---
 crates/auth/src/helper/service.rs    | 2 +-
 crates/cli/src/control/doctor/mod.rs | 5 ++++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/crates/auth/src/helper/service.rs b/crates/auth/src/helper/service.rs
index 43d260f..c6475c9 100644
--- a/crates/auth/src/helper/service.rs
+++ b/crates/auth/src/helper/service.rs
@@ -7,7 +7,7 @@ pub struct PamService {
 }
 
 pub fn selected_service() -> Option<PamService> {
-    select_service_at(Path::new("/etc/pam.d"))
+    select_service_at(Path::new("/usr/share/defaults/etc/pam.d"))
 }
 
 fn select_service_at(root: &Path) -> Option<PamService> {
diff --git a/crates/cli/src/control/doctor/mod.rs b/crates/cli/src/control/doctor/mod.rs
index a79d56d..22bb210 100644
--- a/crates/cli/src/control/doctor/mod.rs
+++ b/crates/cli/src/control/doctor/mod.rs
@@ -153,7 +153,10 @@ fn check_pam(summary: &mut DoctorSummary) {
     match veila_auth::selected_service() {
         Some(service) => {
             println!("pam.service={}", service.name);
-            println!("pam.service_path=/etc/pam.d/{}", service.name);
+            println!(
+                "pam.service_path=/usr/share/defaults/etc/pam.d/{}",
+                service.name
+            );
             if service.fallback {
                 summary.record(
                     "pam",
