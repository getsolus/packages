From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Muhammad Alfi Syahrin <malfisya.dev@hotmail.com>
Date: Sat, 3 Oct 2026 13:21:16 +0700
Subject: [PATCH] Fix invalid meson variable

---
 16x16/meson.build        | 2 +-
 16x16/places/meson.build | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/16x16/meson.build b/16x16/meson.build
index b353ab4..01fade5 100644
--- a/16x16/meson.build
+++ b/16x16/meson.build
@@ -1,3 +1,3 @@
-16x16_iconsdir = join_paths(iconsdir, '16x16')
+_16x16_iconsdir = join_paths(iconsdir, '16x16')
 
 subdir('places')
diff --git a/16x16/places/meson.build b/16x16/places/meson.build
index d08a698..debf2d6 100644
--- a/16x16/places/meson.build
+++ b/16x16/places/meson.build
@@ -1,4 +1,4 @@
-16x16_places_iconsdir = join_paths(16x16_iconsdir, 'places')
+_16x16_places_iconsdir = join_paths(_16x16_iconsdir, 'places')
 
 regular_files = [
     # DO NOT REMOVE: Begining of regular segment
@@ -370,10 +370,10 @@ link_files = {
     # DO NOT REMOVE: End of link segment
 }
 
-install_data(regular_files, install_dir: 16x16_places_iconsdir)
+install_data(regular_files, install_dir: _16x16_places_iconsdir)
 
 foreach dest_file, link_files_for_dest : link_files
     foreach link_file : link_files_for_dest
-        install_symlink(link_file, install_dir: 16x16_places_iconsdir, pointing_to: dest_file)
+        install_symlink(link_file, install_dir: _16x16_places_iconsdir, pointing_to: dest_file)
     endforeach
 endforeach
