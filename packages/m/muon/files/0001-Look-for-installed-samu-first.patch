From 4e5524d5837525facd697acd8b697e7f7c821544 Mon Sep 17 00:00:00 2001
From: uni-dos <uni.dos12@outlook.com>
Date: Sun, 4 Oct 2026 16:28:04 -0700
Subject: [PATCH] ninja_run: check both ninja and samu

Look for samu after checking for ninja.
---
 src/backend/ninja.c | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/backend/ninja.c b/src/backend/ninja.c
index 3c3822fe..aeed30f5 100644
--- a/src/backend/ninja.c
+++ b/src/backend/ninja.c
@@ -241,9 +241,16 @@ ninja_run(struct workspace *wk, obj args, const char *chdir, const char *capture
 			.requirement = requirement_required,
 			.machine = machine_kind_build,
 		};
-		if (!find_program(wk, &fp_ctx, make_str(wk, "ninja"))) {
-			goto ret;
-		} else if (!fp_ctx.found) {
+
+		const char *ninja_impls[] = { "samu", "ninja" };
+
+		for (uint32_t i = 0; i < ARRAY_LEN(ninja_impls); ++i) {
+			if (find_program(wk, &fp_ctx, make_str(wk, ninja_impls[i])) && fp_ctx.found) {
+				break;
+			}
+		}
+
+		if (!fp_ctx.found) {
 			goto ret;
 		}
 
-- 
