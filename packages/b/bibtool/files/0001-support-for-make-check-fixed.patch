 AutoConf/makefile.in | 1 +
 Changes.tex          | 5 ++++-
 makefile.unx         | 1 +
 3 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/AutoConf/makefile.in b/AutoConf/makefile.in
index 0a9bbe3..4ae395a 100644
--- a/AutoConf/makefile.in
+++ b/AutoConf/makefile.in
@@ -531,6 +531,7 @@ d-o-c:
 info:
 
 test check: Test
+	@echo
 Test:
 	(cd test; $(MAKE))
 
diff --git a/makefile.unx b/makefile.unx
index efdfe8d..b8e34e4 100644
--- a/makefile.unx
+++ b/makefile.unx
@@ -529,6 +529,7 @@ d-o-c:
 	cd doc; $(MAKE) DIR_SEP=$(DIR_SEP)
 
 test check: Test
+	@echo
 Test:
 	(cd test; $(MAKE))
 
