From 9d9c35d62cf4e3a4a4bb02ccc444722ec5f50e63 Mon Sep 17 00:00:00 2001
From: Joshua Strobl <me@joshuastrobl.com>
Date: Sun, 4 Oct 2026 19:35:09 +0300
Subject: [PATCH] fix(panel): show the panel when a stored applet can't be
 loaded

The panel only shows itself once every applet uuid in its stored list
has been added. When an applet's plugin was not installed, or its module
failed to load, add_pending() returned without removing the uuid from
expected_uuids, so the panel never finished loading and never showed.

Stop expecting those uuids, and treat the panel as loaded when none of
its stored applets could be added.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Joshua Strobl <me@joshuastrobl.com>
---
 src/panel/panel.vala | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/panel/panel.vala b/src/panel/panel.vala
index b910d9a74..be996839c 100644
--- a/src/panel/panel.vala
+++ b/src/panel/panel.vala
@@ -831,6 +831,11 @@ namespace Budgie {
 					end_applets.nth_data(i).position = i;
 					add_applet(end_applets.nth_data(i));
 				}
+
+				if (!this.is_fully_loaded && expected_uuids.is_empty()) { // no stored applet was loadable, so add_applet never emitted it
+					this.is_fully_loaded = true;
+					this.panel_loaded();
+				}
 			}
 		}
 
@@ -1212,6 +1217,7 @@ namespace Budgie {
 
 			if (!this.plugin_manager.is_plugin_valid(plugin_name)) {
 				warning("Not adding invalid plugin: %s %s", plugin_name, uuid);
+				stop_expecting(uuid);
 				return null;
 			}
 
@@ -1229,6 +1235,12 @@ namespace Budgie {
 				table = pending.lookup(plugin_name);
 				table.insert(uuid, uuid);
 				this.plugin_manager.modprobe(plugin_name);
+
+				if (!this.plugin_manager.is_plugin_loaded(plugin_name)) { // modprobe is synchronous, so the plugin failed to load
+					warning("Not adding applet whose plugin failed to load: %s %s", plugin_name, uuid);
+					pending.remove(plugin_name);
+					stop_expecting(uuid);
+				}
 				return null;
 			}
 
@@ -1244,6 +1256,19 @@ namespace Budgie {
 			return info;
 		}
 
+		/**
+		* Stop waiting on an applet that will never be added, so the
+		* panel can still finish loading
+		*/
+		void stop_expecting(string uuid) {
+			lock (expected_uuids) {
+				unowned List<string?> g = expected_uuids.find_custom(uuid, strcmp);
+				if (g != null) {
+					expected_uuids.remove_link(g);
+				}
+			}
+		}
+
 		public override void map() {
 			base.map();
 			placement();
