diff --git a/src/appindexer/AppInfoStore.vala b/src/appindexer/AppInfoStore.vala
new file mode 100644
index 000000000..4a406a4ab
--- /dev/null
+++ b/src/appindexer/AppInfoStore.vala
@@ -0,0 +1,73 @@
+/*
+ * This file is part of budgie-desktop
+ *
+ * Copyright Budgie Desktop Developers
