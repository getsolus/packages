From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Evan Maddock <maddock.evan@vivaldi.net>
Date: Sat, 26 Sep 2026 16:53:12 -0400
Subject: [PATCH] schemas: Disable donation nag from gnome-settings-daemon

Signed-off-by: Evan Maddock <maddock.evan@vivaldi.net>
---
 schemas/meson.build                                             | 1 +
 ....gnome.settings-daemon.plugins.housekeeping.gschema.override | 2 ++
 2 files changed, 3 insertions(+)
 create mode 100644 schemas/org.gnome.settings-daemon.plugins.housekeeping.gschema.override

diff --git a/schemas/meson.build b/schemas/meson.build
index 04eced9..9c10423 100644
--- a/schemas/meson.build
+++ b/schemas/meson.build
@@ -12,6 +12,7 @@ schemas = [
     'org.gnome.gedit.preferences.editor.gschema.override',
     'org.gnome.nautilus.icon-view.gschema.override',
     'org.gnome.nautilus.preferences.gschema.override',
+    'org.gnome.settings-daemon.plugins.housekeeping.gschema.override',
     'org.gtk.settings.file-chooser.gschema.override',
     'org.nemo.desktop.gschema.override',
     'org.nemo.preferences.gschema.override',
diff --git a/schemas/org.gnome.settings-daemon.plugins.housekeeping.gschema.override b/schemas/org.gnome.settings-daemon.plugins.housekeeping.gschema.override
new file mode 100644
index 0000000..fdb9047
--- /dev/null
+++ b/schemas/org.gnome.settings-daemon.plugins.housekeeping.gschema.override
@@ -0,0 +1,2 @@
+[org.gnome.settings-daemon.plugins.housekeeping]
+donation-reminder-enabled=false
