From 7015954a0a7cbab667396ead4515e497c6634963 Mon Sep 17 00:00:00 2001
From: Fluffinity <fluffinity@noreply.codeberg.org>
Date: Tue, 4 Aug 2026 12:53:06 +0200
Subject: [PATCH 3/3] fix(keys): immediately save keys file after creating

Currently the keys file only gets saved after a corresponding `auth`
command has finished. If an error occurs during it, the file never gets
saved, showing the user the keys-file-not-found prompt again on the next
invocation. Just immediately save an empty keys file instead, letting
`fj` load that one instead of going through the entire fallback path
again.

Modified for 0.6.0 on Solus
---
 src/keys.rs | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/src/keys.rs b/src/keys.rs
index 2cdb171..375263d 100644
--- a/src/keys.rs
+++ b/src/keys.rs
@@ -32,9 +32,7 @@ impl KeyInfo {
                 ftl_println!("msg-old-key-file-read");
                 serde_json::from_slice::<Self>(&x)?
             }
-            Err(e) if e.kind() == ErrorKind::NotFound => {
-                return Ok(Self::default());
-            }
+            Err(e) if e.kind() == ErrorKind::NotFound => Self::default(),
             Err(e) => return Err(e.into()),
         };
         if this.save().await.is_err() {
-- 
