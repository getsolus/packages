 #include "nsProxyRelease.h"
+#ifdef MOZ_WIDGET_GTK
+#  include "nsIGIOService.h"
+#  include "nsServiceManagerUtils.h"
+#endif
 
 // XXX why does nsMIMEInfoImpl have a threadsafe nsISupports?  do we need one
 // here too?
@@ -188,6 +192,23 @@ nsLocalHandlerApp::Equals(nsIHandlerApp* aHandlerApp, bool* _retval) {
 NS_IMETHODIMP
 nsLocalHandlerApp::LaunchWithURI(
     nsIURI* aURI, mozilla::dom::BrowsingContext* aBrowsingContext) {
+#ifdef MOZ_WIDGET_GTK
+  // Launch through GIO, as handler applications from desktop entries are, so
+  // that the handler receives an activation token on Wayland. When GIO cannot
+  // run the executable, nsIProcess reports the error.
+  nsCOMPtr<nsIGIOService> gio = do_GetService(NS_GIOSERVICE_CONTRACTID);
+  if (gio && mExecutable) {
+    nsAutoString name;
+    GetName(name);
+    nsCOMPtr<nsIGIOMimeApp> app;
+    if (NS_SUCCEEDED(gio->CreateAppFromExecutable(mExecutable,
+                                                  NS_ConvertUTF16toUTF8(name),
+                                                  true, getter_AddRefs(app)))) {
+      return app->LaunchWithURI(aURI, aBrowsingContext);
+    }
+  }
+#endif
+
   // pass the entire URI to the handler.
   nsAutoCString spec;
   aURI->GetAsciiSpec(spec);
diff --git a/uriloader/exthandler/nsMIMEInfoImpl.cpp b/uriloader/exthandler/nsMIMEInfoImpl.cpp
index e7de7823f4553..825f81d866779 100644
--- a/uriloader/exthandler/nsMIMEInfoImpl.cpp
+++ b/uriloader/exthandler/nsMIMEInfoImpl.cpp
@@ -21,6 +21,10 @@
 #include "mozilla/StaticPrefs_browser.h"
 #include "xpcpublic.h"
 #include "nsIGIOService.h"
+#ifdef MOZ_WIDGET_GTK
+#  include "nsNetUtil.h"
+#  include "nsServiceManagerUtils.h"
+#endif
 
 static bool sInitializedOurData = false;
 mozilla::StaticRefPtr<nsIFile> sOurAppFile;
@@ -341,7 +345,7 @@ nsMIMEInfoBase::LaunchWithFile(nsIFile* aFile) {
     rv = localHandler->GetExecutable(getter_AddRefs(executable));
     NS_ENSURE_SUCCESS(rv, rv);
 
-    return LaunchWithIProcess(executable, aFile->NativePath());
+    return LaunchAppWithFile(executable, aFile);
   }
 
   return NS_ERROR_INVALID_ARG;
@@ -477,6 +481,27 @@ nsresult nsMIMEInfoBase::LaunchWithIProcess(nsIFile* aApp, const int aArgc,
   return process->Runw(false, aArgv, aArgc);
 }
 
+/* static */
+nsresult nsMIMEInfoBase::LaunchAppWithFile(nsIFile* aApp, nsIFile* aFile) {
+#ifdef MOZ_WIDGET_GTK
+  // GIO passes the path of the file which the file URI names. When GIO cannot
+  // run the executable, nsIProcess reports the error.
+  nsCOMPtr<nsIGIOService> gio = do_GetService(NS_GIOSERVICE_CONTRACTID);
+  nsCOMPtr<nsIURI> uri;
+  if (gio && NS_SUCCEEDED(NS_NewFileURI(getter_AddRefs(uri), aFile))) {
+    nsAutoString name;
+    aApp->GetLeafName(name);
+    nsCOMPtr<nsIGIOMimeApp> app;
+    if (NS_SUCCEEDED(gio->CreateAppFromExecutable(
+            aApp, NS_ConvertUTF16toUTF8(name), false, getter_AddRefs(app)))) {
+      return app->LaunchWithURI(uri, nullptr);
+    }
+  }
+#endif
+
+  return LaunchWithIProcess(aApp, aFile->NativePath());
+}
+
 // nsMIMEInfoImpl implementation
 NS_IMETHODIMP
 nsMIMEInfoImpl::GetDefaultDescription(nsAString& aDefaultDescription) {
@@ -538,7 +563,7 @@ nsresult nsMIMEInfoImpl::LaunchDefaultWithFile(nsIFile* aFile) {
     return NS_ERROR_FILE_NOT_FOUND;
   }
 
-  return LaunchWithIProcess(defaultApp, aFile->NativePath());
+  return LaunchAppWithFile(defaultApp, aFile);
 }
 
 NS_IMETHODIMP
