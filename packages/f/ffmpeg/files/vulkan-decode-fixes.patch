+        av_log(hwfc, AV_LOG_VERBOSE, "GetPhysicalDeviceImageFormatProperties2: mod[%d]=0x%llx -> %s\n",
+               i, has_mods ? (unsigned long long)phy_dev_mod_info.drmFormatModifier : 0ULL,
