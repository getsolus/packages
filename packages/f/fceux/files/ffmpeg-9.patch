+/* avcodec_get_supported_config() replaced AVCodec.pix_fmts / sample_fmts /
+ * supported_samplerates / ch_layouts (removed in FFmpeg 9 / lavc 63). */
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 13, 100)
+#define HAVE_AVCODEC_GET_SUPPORTED_CONFIG 1
+#else
+#define HAVE_AVCODEC_GET_SUPPORTED_CONFIG 0
+#endif
+
+static const enum AVPixelFormat *fceux_avcodec_pix_fmts(const AVCodec *codec)
+{
+#if HAVE_AVCODEC_GET_SUPPORTED_CONFIG
+	const void *configs = NULL;
+	if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_PIX_FORMAT, 0, &configs, NULL) < 0)
+		return NULL;
+	return (const enum AVPixelFormat *)configs;
+#else
+	return codec->pix_fmts;
+#endif
+}
+
+static const enum AVSampleFormat *fceux_avcodec_sample_fmts(const AVCodec *codec)
+{
+#if HAVE_AVCODEC_GET_SUPPORTED_CONFIG
+	const void *configs = NULL;
+	if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_SAMPLE_FORMAT, 0, &configs, NULL) < 0)
+		return NULL;
+	return (const enum AVSampleFormat *)configs;
+#else
+	return codec->sample_fmts;
+#endif
+}
+
+static const int *fceux_avcodec_supported_samplerates(const AVCodec *codec)
+{
+#if HAVE_AVCODEC_GET_SUPPORTED_CONFIG
+	const void *configs = NULL;
+	if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_SAMPLE_RATE, 0, &configs, NULL) < 0)
+		return NULL;
+	return (const int *)configs;
+#else
+	return codec->supported_samplerates;
+#endif
+}
+
+#if LIBAVUTIL_VERSION_INT >= AV_VERSION_INT(57, 28, 100)
+static const AVChannelLayout *fceux_avcodec_ch_layouts(const AVCodec *codec)
+{
+#if HAVE_AVCODEC_GET_SUPPORTED_CONFIG
+	const void *configs = NULL;
+	if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_CHANNEL_LAYOUT, 0, &configs, NULL) < 0)
+		return NULL;
+	return (const AVChannelLayout *)configs;
+#else
+	return codec->ch_layouts;
+#endif
+}
+#endif
 #endif
 
