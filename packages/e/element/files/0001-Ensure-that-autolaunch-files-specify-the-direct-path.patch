 the wrapper script

---
 apps/desktop/src/auto-launch.ts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/apps/desktop/src/auto-launch.ts b/apps/desktop/src/auto-launch.ts
index 54271127c1..6f0d349987 100644
--- a/apps/desktop/src/auto-launch.ts
+++ b/apps/desktop/src/auto-launch.ts
@@ -22,6 +22,7 @@ export class AutoLaunch extends BaseAutoLaunch {
             AutoLaunch.internalInstance = new AutoLaunch({
                 name: getConfig().brand,
                 isHidden: Store.instance.get("openAtLoginMinimised"),
+                path: "/usr/bin/element-desktop",
                 mac: {
                     useLaunchAgent: true,
                 },
