From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Silke Hofstra <silke@slxh.eu>
Date: Wed, 30 Sep 2026 13:31:26 +0200
Subject: [PATCH 2/3] Fix Wayland AppID

---
 apps/desktop/electron-builder.ts           | 2 +-
 apps/desktop/element.io/release/build.json | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/electron-builder.ts b/apps/desktop/electron-builder.ts
index 60ad572e26..ca21f244a2 100644
--- a/apps/desktop/electron-builder.ts
+++ b/apps/desktop/electron-builder.ts
@@ -136,7 +136,7 @@ const config: Omit<Writable<Configuration>, "electronFuses"> & {
         // Read by Electron to set the Wayland app_id / X11 WM_CLASS, so compositors
         // can associate our windows with the desktop file of the same name.
         // https://www.electron.build/linux#window-association-desktopname--syncdesktopname
-        desktopName: `${variant.name}.desktop`,
+        desktopName: `${variant.desktopName}`,
         electron_appId: variant.appId,
         electron_protocol: variant.protocols[0],
     },
diff --git a/apps/desktop/element.io/release/build.json b/apps/desktop/element.io/release/build.json
index 33b85f7e48..05d641fc7d 100644
--- a/apps/desktop/element.io/release/build.json
+++ b/apps/desktop/element.io/release/build.json
@@ -1,6 +1,7 @@
 {
     "appId": "im.riot.app",
     "name": "element-desktop",
+    "desktopName": "im.riot.Riot.desktop",
     "productName": "Element",
     "description": "Element: the future of secure communication",
     "protocols": ["io.element.desktop", "element"]
