From bbdffd4ca99c43537ffea3839bebed24d94dd288 Mon Sep 17 00:00:00 2001
From: Gavin Zhao <git@gzgz.dev>
Date: Wed, 29 Jul 2026 06:56:12 -0700
Subject: [PATCH 1/3] [tensile] Repesect TENSILE_ROCM_OFFLOAD_BUNDLER_PATH

---
 shared/tensile/Tensile/Utilities/Toolchain.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/shared/tensile/Tensile/Utilities/Toolchain.py b/shared/tensile/Tensile/Utilities/Toolchain.py
index e71f5d0513d..c680e1eb942 100644
--- a/shared/tensile/Tensile/Utilities/Toolchain.py
+++ b/shared/tensile/Tensile/Utilities/Toolchain.py
@@ -226,6 +226,15 @@ def _validateExecutable(file: str, searchPaths: List[Path]) -> str:
     ):
         raise ValueError(f"{file} is not a supported toolchain component for OS: {os.name}")
 
+    # Allow explicit override for offload bundler via environment variable
+    if (
+        os.environ.get("TENSILE_ROCM_OFFLOAD_BUNDLER_PATH")
+        and supportedOffloadBundler(file)
+    ):
+        bundler = Path(os.environ["TENSILE_ROCM_OFFLOAD_BUNDLER_PATH"])
+        if bundler.is_file() and os.access(bundler, os.X_OK):
+            return str(bundler)
+
     if _exeExists(Path(file)):
         return file
 
