From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Evan Maddock <maddock.evan@vivaldi.net>
Date: Thu, 12 Nov 2026 13:33:44 -0500
Subject: [PATCH] templates/kitty: Add styling for internal borders

This makes the borders of panes inside Kitty match the outer window
border. The result is that everything looks more integrated.

Signed-off-by: Evan Maddock <maddock.evan@vivaldi.net>
---
 quickshell/matugen/templates/kitty.conf | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/quickshell/matugen/templates/kitty.conf b/quickshell/matugen/templates/kitty.conf
index c140ff377..c4b97d691 100644
--- a/quickshell/matugen/templates/kitty.conf
+++ b/quickshell/matugen/templates/kitty.conf
@@ -5,6 +5,8 @@ foreground            {{colors.on_surface.default.hex}}
 background            {{colors.background.default.hex}}
 selection_foreground  {{colors.on_secondary.default.hex}}
 selection_background  {{colors.secondary_fixed_dim.default.hex}}
+active_border_color   {{colors.primary.default.hex}}
+inactive_border_color {{colors.background.default.hex}}
 url_color             {{colors.primary.default.hex}}
 
 color0   {{dank16.color0.default.hex}}
