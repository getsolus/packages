Subject: [PATCH 1/1] plymouth: Fix libexecdir check for Solus

---
 modules.d/45plymouth/module-setup.sh | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/modules.d/45plymouth/module-setup.sh b/modules.d/45plymouth/module-setup.sh
index 215d594f..bdb83861 100755
--- a/modules.d/45plymouth/module-setup.sh
+++ b/modules.d/45plymouth/module-setup.sh
@@ -6,6 +6,10 @@ pkglib_dir() {
             echo "$_dir/plymouth"
             return
         fi
+        if [ -x "${dracutsysrootdir-}$_dir/plymouth/plymouth/plymouth-populate-initrd" ]; then
+            echo "$_dir/plymouth/plymouth"
+            return
+        fi
     done
 }
 
