From 696ef828f7e830731e5b984a27843174bff34aa5 Mon Sep 17 00:00:00 2001
From: Gavin Zhao <git@gzgz.dev>
Date: Sat, 8 Aug 2026 18:01:08 -0700
Subject: [PATCH 3/4] [composable_kernel] Add (unoptimized) gfx9-generic
 support

---
 projects/composablekernel/include/ck/ck.hpp              | 3 ++-
 .../composablekernel/include/ck_tile/core/config.hpp     | 9 ++++++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/projects/composablekernel/include/ck/ck.hpp b/projects/composablekernel/include/ck/ck.hpp
index d914bbbd3ca..fadaefdb55d 100644
--- a/projects/composablekernel/include/ck/ck.hpp
+++ b/projects/composablekernel/include/ck/ck.hpp
@@ -85,7 +85,8 @@
 // buffer resource
 #ifndef __HIP_DEVICE_COMPILE__ // for host code
 #define CK_BUFFER_RESOURCE_3RD_DWORD -1
-#elif defined(__gfx803__) || defined(__gfx900__) || defined(__gfx906__) || defined(__gfx9__)
+#elif defined(__gfx803__) || defined(__gfx900__) || defined(__gfx906__) || defined(__gfx9__) || \
+    defined(__gfx9_generic__)
 #define CK_BUFFER_RESOURCE_3RD_DWORD 0x00020000
 #elif defined(__gfx101__) || defined(__gfx103__)
 #define CK_BUFFER_RESOURCE_3RD_DWORD 0x31014000
diff --git a/projects/composablekernel/include/ck_tile/core/config.hpp b/projects/composablekernel/include/ck_tile/core/config.hpp
index ba17a2710c7..ca750528101 100644
--- a/projects/composablekernel/include/ck_tile/core/config.hpp
+++ b/projects/composablekernel/include/ck_tile/core/config.hpp
@@ -279,7 +279,7 @@
 #ifndef __HIP_DEVICE_COMPILE__ // for host code
 #define CK_TILE_BUFFER_RESOURCE_3RD_DWORD 0xffffffff
 #elif defined(__gfx803__) || defined(__gfx900__) || defined(__gfx906__) || \
-    defined(__gfx9__) // for GPU code
+    defined(__gfx9__) || defined(__gfx9_generic__) // for GPU code
 #define CK_TILE_BUFFER_RESOURCE_3RD_DWORD 0x00020000
 #elif defined(__gfx101__) || defined(__gfx103__) // for GPU code
 #define CK_TILE_BUFFER_RESOURCE_3RD_DWORD 0x31014000
@@ -423,6 +423,12 @@ struct amdgcn_compiler_target_state
     static constexpr bool CK_TILE_ARCH_GFX908 = false;
 #endif // __gfx908__
 
+#if defined(__gfx9_generic__)
+    static constexpr bool CK_TILE_ARCH_GFX9_GENERIC = true;
+#else
+    static constexpr bool CK_TILE_ARCH_GFX9_GENERIC = false;
+#endif // __gfx9_generic__
+
 #if defined(__gfx90a__)
     static constexpr bool CK_TILE_ARCH_GFX90A = true;
 #else
@@ -623,6 +629,7 @@ CK_TILE_HOST_DEVICE static constexpr std::uint32_t count_values_of(T search, Ts.
         amdgcn_compiler_target_state::CK_TILE_ARCH_GFX90A,          \
         amdgcn_compiler_target_state::CK_TILE_ARCH_GFX942,          \
         amdgcn_compiler_target_state::CK_TILE_ARCH_GFX950,          \
+        amdgcn_compiler_target_state::CK_TILE_ARCH_GFX9_GENERIC,  \
         amdgcn_compiler_target_state::CK_TILE_ARCH_GFX1010,         \
         amdgcn_compiler_target_state::CK_TILE_ARCH_GFX1011,         \
         amdgcn_compiler_target_state::CK_TILE_ARCH_GFX1012,         \
-- 
2.55.0

