From e85957bc4621003cd11485b4a2188c5f02cfc87d Mon Sep 17 00:00:00 2001
From: Gavin Zhao <git@gzgz.dev>
Date: Mon, 16 Feb 2026 03:39:07 -0500
Subject: [PATCH 1/4] [composable_kernel] Add ck- prefix to library names to
 prevent conflict

---
 .../src/tensor_operation_instance/gpu/CMakeLists.txt       | 7 ++++++-
 .../composablekernel/library/src/utility/CMakeLists.txt    | 2 ++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/projects/composablekernel/library/src/tensor_operation_instance/gpu/CMakeLists.txt b/projects/composablekernel/library/src/tensor_operation_instance/gpu/CMakeLists.txt
index 40343c2cc9d..d497e73e886 100644
--- a/projects/composablekernel/library/src/tensor_operation_instance/gpu/CMakeLists.txt
+++ b/projects/composablekernel/library/src/tensor_operation_instance/gpu/CMakeLists.txt
@@ -544,6 +544,7 @@ if(CK_DEVICE_OTHER_INSTANCES AND (NOT MIOPEN_REQ_LIBS_ONLY OR HIPTENSOR_REQ_LIBS
             PROPERTIES
             VERSION ${CMAKE_PROJECT_VERSION}
             SOVERSION ${CMAKE_PROJECT_VERSION_MAJOR}
+            OUTPUT_NAME ck_device_other_operations
         )
         target_include_directories(device_other_operations PUBLIC
             $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/ck>
@@ -581,6 +582,7 @@ if(CK_DEVICE_GEMM_INSTANCES AND NOT MIOPEN_REQ_LIBS_ONLY AND NOT HIPTENSOR_REQ_L
             PROPERTIES
             VERSION ${CMAKE_PROJECT_VERSION}
             SOVERSION ${CMAKE_PROJECT_VERSION_MAJOR}
+            OUTPUT_NAME ck_device_gemm_operations
         )
         target_include_directories(device_gemm_operations PUBLIC
             $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/ck/library/tensor_operation_instance/gpu>
@@ -593,7 +595,6 @@ if(CK_DEVICE_GEMM_INSTANCES AND NOT MIOPEN_REQ_LIBS_ONLY AND NOT HIPTENSOR_REQ_L
             DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/composable_kernel
         )
 endif()
-
 if(CK_DEVICE_MHA_INSTANCES AND NOT MIOPEN_REQ_LIBS_ONLY AND NOT HIPTENSOR_REQ_LIBS_ONLY AND BUILD_MHA_LIB)
         set(gpu_list ${INST_TARGETS})
         if(gpu_list MATCHES "gfx94" OR gpu_list MATCHES "gfx90a" OR gpu_list MATCHES "gfx95")
@@ -602,6 +603,7 @@ if(CK_DEVICE_MHA_INSTANCES AND NOT MIOPEN_REQ_LIBS_ONLY AND NOT HIPTENSOR_REQ_LI
                 PROPERTIES
                 VERSION ${CMAKE_PROJECT_VERSION}
                 SOVERSION ${CMAKE_PROJECT_VERSION_MAJOR}
+                OUTPUT_NAME ck_device_mha_operations
             )
             add_library(composablekernels::device_mha_operations ALIAS device_mha_operations)
             target_compile_features(device_mha_operations PUBLIC)
@@ -625,6 +627,7 @@ if(CK_DEVICE_CONTRACTION_INSTANCES AND (NOT MIOPEN_REQ_LIBS_ONLY OR HIPTENSOR_RE
             PROPERTIES
             VERSION ${CMAKE_PROJECT_VERSION}
             SOVERSION ${CMAKE_PROJECT_VERSION_MAJOR}
+            OUTPUT_NAME ck_device_contraction_operations
         )
         target_include_directories(device_contraction_operations PUBLIC
             $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/ck/library/tensor_operation_instance/gpu>
@@ -647,6 +650,7 @@ if(CK_DEVICE_REDUCTION_INSTANCES AND (NOT MIOPEN_REQ_LIBS_ONLY OR HIPTENSOR_REQ_
             PROPERTIES
             VERSION ${CMAKE_PROJECT_VERSION}
             SOVERSION ${CMAKE_PROJECT_VERSION_MAJOR}
+            OUTPUT_NAME ck_device_reduction_operations
         )
         target_include_directories(device_reduction_operations PUBLIC
             $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/ck/library/tensor_operation_instance/gpu/reduce>
@@ -677,6 +681,7 @@ if(CK_DEVICE_CONV_INSTANCES AND (NOT HIPTENSOR_REQ_LIBS_ONLY OR MIOPEN_REQ_LIBS_
         PROPERTIES
         VERSION ${CMAKE_PROJECT_VERSION}
         SOVERSION ${CMAKE_PROJECT_VERSION_MAJOR}
+        OUTPUT_NAME ck_device_conv_operations
     )
     target_include_directories(device_conv_operations PUBLIC
         $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/ck/library/tensor_operation_instance/gpu>
diff --git a/projects/composablekernel/library/src/utility/CMakeLists.txt b/projects/composablekernel/library/src/utility/CMakeLists.txt
index f7bc1acf59b..19fd9ed372f 100644
--- a/projects/composablekernel/library/src/utility/CMakeLists.txt
+++ b/projects/composablekernel/library/src/utility/CMakeLists.txt
@@ -22,6 +22,8 @@ if(WIN32)
     target_compile_definitions(utility PUBLIC NOMINMAX)
 endif()
 
+set_target_properties(utility PROPERTIES OUTPUT_NAME ck_utility)
+
 rocm_install(
     TARGETS utility
     EXPORT utilityTargets
