From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Evan Maddock <maddock.evan@vivaldi.net>
Date: Mon, 23 Nov 2026 13:46:37 -0500
Subject: [PATCH] Solus login.defs changes

Change home mode for Samba share, and use yescrypt by default.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-11-23
---
 etc/login.defs | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/etc/login.defs b/etc/login.defs
index 388a774d..05f50243 100644
--- a/etc/login.defs
+++ b/etc/login.defs
@@ -204,7 +204,9 @@ UMASK		022
 # HOME_MODE is used by useradd(8) and newusers(8) to set the mode for new
 # home directories.
 # If HOME_MODE is not set, the value of UMASK is used to create the mode.
-#HOME_MODE	0700
+# sshd `StrictModes yes` default does not allow group writable $HOME, hence g=rx
+# samba usershare functionality requires o=x set
+HOME_MODE	0751
 
 #
 # If "yes", the user must be listed as a member of the first gid 0 group
@@ -220,7 +222,7 @@ SU_WHEEL_ONLY	no
 UID_MIN			 1000
 UID_MAX			60000
 # System accounts
-SYS_UID_MIN		  101
+SYS_UID_MIN		  201
 SYS_UID_MAX		  999
 # Extra per user uids
 SUB_UID_MIN		   100000
@@ -268,7 +270,7 @@ SUB_UID_COUNT		    65536
 GID_MIN			 1000
 GID_MAX			60000
 # System accounts
-SYS_GID_MIN		  101
+SYS_GID_MIN		  201
 SYS_GID_MAX		  999
 # Extra per user group ids
 SUB_GID_MIN		   100000
@@ -331,7 +333,7 @@ PASS_CHANGE_TRIES	5
 # Warn about weak passwords (but still allow them) if you are root.
 PASS_ALWAYS_WARN	yes
 # Minimum acceptable password length.
-PASS_MIN_LEN	5
+PASS_MIN_LEN	8
 
 #
 # Require password before chfn(1)/chsh(1) can make any changes.
@@ -363,7 +365,7 @@ CHFN_RESTRICT		rwh
 # Note: if you use PAM, it is recommended to use a value consistent with
 # the PAM modules configuration.
 #
-#ENCRYPT_METHOD SHA512
+ENCRYPT_METHOD YESCRYPT
 
 #
 # Only works if ENCRYPT_METHOD is set to SHA256 or SHA512.
