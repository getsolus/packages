From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Troy Harvey <harvey@getsol.us>
Date: Sun, 8 Nov 2026 09:47:13 +1100
Subject: [PATCH] Move to plasma-login-manager

Signed-off-by: Troy Harvey <harvey@getsol.us>
---
 meson.build                                | 2 +-
 plasma-login-manager/20_plasma_config.conf | 2 ++
 plasma-login-manager/99_plasma_livecd.conf | 4 ++++
 plasma-login-manager/meson.build           | 7 +++++++
 4 files changed, 14 insertions(+), 1 deletion(-)
 create mode 100644 plasma-login-manager/20_plasma_config.conf
 create mode 100644 plasma-login-manager/99_plasma_livecd.conf
 create mode 100644 plasma-login-manager/meson.build

diff --git a/meson.build b/meson.build
index 114a53e..b14715e 100644
--- a/meson.build
+++ b/meson.build
@@ -22,7 +22,7 @@ if path_envdir == ''
 endif
 
 subdir('solus-desktoptheme')
-subdir('sddm')
+subdir('plasma-login-manager')
 subdir('xdg')
 
 
diff --git a/plasma-login-manager/20_plasma_config.conf b/plasma-login-manager/20_plasma_config.conf
new file mode 100644
index 0000000..2dfde5d
--- /dev/null
+++ b/plasma-login-manager/20_plasma_config.conf
@@ -0,0 +1,2 @@
+[Theme]
+Current=breeze
diff --git a/plasma-login-manager/99_plasma_livecd.conf b/plasma-login-manager/99_plasma_livecd.conf
new file mode 100644
index 0000000..9a2af6e
--- /dev/null
+++ b/plasma-login-manager/99_plasma_livecd.conf
@@ -0,0 +1,4 @@
+[Autologin]
+Relogin=false
+Session=plasma.desktop
+User=live
diff --git a/plasma-login-manager/meson.build b/plasma-login-manager/meson.build
new file mode 100644
index 0000000..f5ceda9
--- /dev/null
+++ b/plasma-login-manager/meson.build
@@ -0,0 +1,7 @@
+plm_dir = join_paths(path_datadir, 'plasmalogin', 'plasmalogin.conf.d')
+
+install_data(
+    '20_plasma_config.conf',
+    '99_plasma_livecd.conf',
+    install_dir: plm_dir,
+)
