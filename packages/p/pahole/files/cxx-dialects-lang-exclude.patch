--- i/dwarves.c
+++ w/dwarves.c
@@ -2420,6 +2420,27 @@
 	return a - b;
 }
 
+/*
+ * All C++ dialects belong to the DW_LANG_C_plus_plus family, so that
+ * e.g. --lang_exclude=c++ also filters C++03/11/14/17/20/23 compilation
+ * units. Without this, "c++" only matches DW_LANG_C_plus_plus (C++98),
+ * letting e.g. GCC's C++11 debug info through.
+ */
+static int lang__family(int id)
+{
+	switch (id) {
+	case DW_LANG_C_plus_plus_03:
+	case DW_LANG_C_plus_plus_11:
+	case DW_LANG_C_plus_plus_14:
+	case DW_LANG_C_plus_plus_17:
+	case DW_LANG_C_plus_plus_20:
+	case DW_LANG_C_plus_plus_23:
+		return DW_LANG_C_plus_plus;
+	default:
+		return id;
+	}
+}
+
 int languages__parse(struct languages *languages, const char *tool)
 {
 	int nr_allocated = 4;
@@ -2455,7 +2476,7 @@
 			languages->entries = entries;
 		}
 
-		languages->entries[languages->nr_entries++] = id;
+		languages->entries[languages->nr_entries++] = lang__family(id);
 
 		if (!sep)
 			break;
@@ -2476,6 +2497,7 @@
 
 bool languages__in(struct languages *languages, int lang)
 {
+	lang = lang__family(lang);
 	return bsearch(&lang, languages->entries, languages->nr_entries, sizeof(int), lang_id_cmp) != NULL;
 }
