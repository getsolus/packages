From ca143265afd38ffae7b8bfe66056373c18eb3c4e Mon Sep 17 00:00:00 2001
From: Volker Krause <vkrause@kde.org>
Date: Sat, 18 Apr 2026 11:24:38 +0200
Subject: [PATCH] Add forward compatibility with KMime from KDE Frameworks

---
 CMakeLists.txt                     | 6 +++++-
 core/CMakeLists.txt                | 2 +-
 core/autotests/mail/CMakeLists.txt | 4 ++--
 3 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d0a2f122..28564b11 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -172,7 +172,11 @@ find_package(KF6Contacts ${KF_MIN_VERSION} CONFIG REQUIRED)
 find_package(KPim6IdentityManagementCore ${IDENTITYMANAGEMENT_LIB_VERSION} CONFIG REQUIRED)
 find_package(KPim6MailCommon ${MAILCOMMON_LIB_VERSION} CONFIG REQUIRED)
 find_package(KPim6MailTransport ${KMAILTRANSPORT_LIB_VERSION} CONFIG REQUIRED)
-find_package(KPim6Mime ${KMIME_LIB_VERSION} CONFIG REQUIRED)
+find_package(KF6Mime ${KF_MIN_VERSION} CONFIG)
+if(NOT TARGET KF6::Mime)
+    find_package(KPim6Mime ${KMIME_LIB_VERSION} CONFIG REQUIRED)
+    add_library(KF6::Mime ALIAS KPim6::Mime)
+endif()
 find_package(KPim6PimCommonAkonadi ${PIMCOMMON_LIB_VERSION} CONFIG REQUIRED)
 find_package(KF6CalendarCore ${KF_MIN_VERSION} CONFIG REQUIRED)
 find_package(KF6TextCustomEditor ${KTEXTADDONS_MIN_VERSION} CONFIG REQUIRED)
diff --git a/core/CMakeLists.txt b/core/CMakeLists.txt
index 5bc5e1e6..60c780e5 100644
--- a/core/CMakeLists.txt
+++ b/core/CMakeLists.txt
@@ -109,7 +109,7 @@ target_link_libraries(
     pimdataexporterprivate
     PRIVATE
         KPim6::AkonadiCore
-        KPim6::Mime
+        KF6::Mime
         KPim6::MailTransport
         KPim6::MailCommon
         KF6::Archive
diff --git a/core/autotests/mail/CMakeLists.txt b/core/autotests/mail/CMakeLists.txt
index 74526706..3baed78c 100644
--- a/core/autotests/mail/CMakeLists.txt
+++ b/core/autotests/mail/CMakeLists.txt
@@ -22,7 +22,7 @@ target_link_libraries(
     pimdataexporterprivate
     KF6::ConfigCore
     test_resourceconverter
-    KPim6::Mime
+    KF6::Mime
 )
 
 #####
@@ -50,7 +50,7 @@ target_link_libraries(
     KPim6::AkonadiMime
     test_resourceconverter
     KPim6::IdentityManagementCore
-    KPim6::Mime
+    KF6::Mime
 )
 
 #####
