From 69efc046aa9f0fa820db9b57d4d6d6679f934caf Mon Sep 17 00:00:00 2001
From: Joey Riches <josephriches@gmail.com>
Date: Thu, 12 Nov 2026 13:06:38 +0000
Subject: [PATCH 1/1] backends/eopkg: Mark security updates with critical
 severity

---
 backends/eopkg/eopkgBackend.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/backends/eopkg/eopkgBackend.py b/backends/eopkg/eopkgBackend.py
index a280ac6bb..1e2fd73ff 100644
--- a/backends/eopkg/eopkgBackend.py
+++ b/backends/eopkg/eopkgBackend.py
@@ -572,7 +572,7 @@ class PackageKitEopkgBackend(PackageKitBaseBackend, PackagekitPackage):
 
             securities = [x for x in histories if x.type == "security"]
             if len(securities) > 0:
-                self.package(id, INFO_SECURITY, pkg.summary)
+                self.package(id, INFO_SECURITY, pkg.summary, INFO_CRITICAL)
             else:
                 self.package(id, INFO_NORMAL, pkg.summary)
 
