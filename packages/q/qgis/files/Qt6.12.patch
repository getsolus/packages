From 708ae043312d519c5f02360a458edb4dfec11670 Mon Sep 17 00:00:00 2001
From: Alexander Bruy <alexander.bruy@gmail.com>
Date: Mon, 9 Nov 2026 10:35:31 +0000
Subject: [PATCH] fix build failure with PyQt >= 6.12.0 caused by duplicated
 QMap<int, int> definition

---
 python/CMakeLists.txt                | 6 ++++++
 python/PyQt6/core/conversions.sip.in | 2 ++
 python/PyQt6/core/core.sip.in        | 1 +
 3 files changed, 9 insertions(+)

diff --git a/python/CMakeLists.txt b/python/CMakeLists.txt
index 2f2c30aa8bd1..1faec58d51c6 100644
--- a/python/CMakeLists.txt
+++ b/python/CMakeLists.txt
@@ -164,6 +164,12 @@ return sipGetState(sipTransferObj);
 };
 ]])
 endif()
+
+# build fails with PyQt6 >= 6.12.0 because of the duplicated mapped type
+if(${PYQT_VERSION_STR} VERSION_GREATER_EQUAL 6.12.0)
+  set(SIP_DISABLE_FEATURES ${SIP_DISABLE_FEATURES} SIP_NEEDS_CONVERSION_QMAP_INT_INT)
+endif()
+
 configure_file(${CMAKE_CURRENT_SOURCE_DIR}/PyQt6/core/conversions.sip.in ${CMAKE_CURRENT_BINARY_DIR}/PyQt6/core/conversions.sip @ONLY)
 
 # Deprecated annotation supports message only since version 6.9.0 with abi-version 12.16 / 13.9 and above
diff --git a/python/PyQt6/core/conversions.sip.in b/python/PyQt6/core/conversions.sip.in
index 5b05c0708fff..80b4d5121063 100644
--- a/python/PyQt6/core/conversions.sip.in
+++ b/python/PyQt6/core/conversions.sip.in
@@ -2227,6 +2227,7 @@ template<TYPE>
 %End
 };
 
+%If (SIP_NEEDS_CONVERSION_QMAP_INT_INT)
 %MappedType QMap<int, int>
 {
   %TypeHeaderCode
@@ -2304,6 +2305,7 @@ template<TYPE>
   return sipGetState(sipTransferObj);
   %End
 };
+%End
 
 template<TYPE1, TYPE2>
 %MappedType QMap<TYPE1, TYPE2*>
diff --git a/python/PyQt6/core/core.sip.in b/python/PyQt6/core/core.sip.in
index 569459319e4e..7da7bd96d73d 100644
--- a/python/PyQt6/core/core.sip.in
+++ b/python/PyQt6/core/core.sip.in
@@ -100,6 +100,7 @@ done:
 %Feature PYQT6
 %Feature HAVE_SFCGAL_SIP
 %Feature MOVABLE_MAPPED_TYPE
+%Feature SIP_NEEDS_CONVERSION_QMAP_INT_INT
 
 %Import QtXml/QtXmlmod.sip
 %Import QtNetwork/QtNetworkmod.sip
