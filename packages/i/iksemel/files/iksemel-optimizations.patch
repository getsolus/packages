From 24bc49c3e4575afc546b4f5cc9fd697ce5a271e9 Mon Sep 17 00:00:00 2001
From: Joey Riches <josephriches@gmail.com>
Date: Mon, 12 Oct 2026 19:56:09 +0100
Subject: [PATCH 5/5] sax: Add SSE2 optimized variant of sax_skip_run()

---
 src/sax.c | 54 ++++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 52 insertions(+), 2 deletions(-)

diff --git a/src/sax.c b/src/sax.c
index fbc4e56..5454393 100644
--- a/src/sax.c
+++ b/src/sax.c
@@ -7,6 +7,10 @@
 #include "common.h"
 #include "iksemel.h"
 
+#if defined(__SSE2__)
+#include <emmintrin.h>
+#endif
+
 enum cons_e {
 	C_CDATA = 0,
 	C_TAG_START,
@@ -301,10 +305,56 @@ sax_skip_run (iksparser *prs, const char *buf, int *pos, int len, unsigned short
 
 	if (char_class[(unsigned char) buf[p]] & mask)
 		return 0;
-	do {
+
+#if defined(__SSE2__)
+	while (p + 16 <= len) {
+		__m128i chunk = _mm_loadu_si128 ((const __m128i *) (buf + p));
+		__m128i m = _mm_cmpeq_epi8 (chunk, _mm_setzero_si128 ());
+		int res;
+
+		/* B_INVALID (NUL) and B_NEWLINE always end a run. */
+		m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 ('\n')));
+		/* Bytes selected by the caller's stop bits. */
+		if (stop & B_CDATA) {
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 ('&')));
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 ('<')));
+		}
+		if (stop & B_WS) {
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 ('\t')));
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 ('\r')));
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 (' ')));
+		}
+		if (stop & B_TAG) {
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 ('/')));
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 ('=')));
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 ('>')));
+		}
+		if (stop & B_APOS)
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 ('\'')));
+		if (stop & B_QUOT)
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 ('"')));
+		if (stop & B_RBRACKET)
+			m = _mm_or_si128 (m, _mm_cmpeq_epi8 (chunk, _mm_set1_epi8 (']')));
+
+		/* _mm_movemask_epi8(chunk) marks every byte with its high bit
+		 * set, so any non-ASCII byte still stops the run. */
+		res = _mm_movemask_epi8 (m) | _mm_movemask_epi8 (chunk);
+		if (res) {
+			int skip = __builtin_ctz (res);
+			p += skip;
+			prs->nr_bytes += skip;
+			*pos = p;
+			return 1;
+		}
+		p += 16;
+		prs->nr_bytes += 16;
+	}
+#endif
+
+	while (p < len && !(char_class[(unsigned char) buf[p]] & mask)) {
 		p++;
 		prs->nr_bytes++;
-	} while (p < len && !(char_class[(unsigned char) buf[p]] & mask));
+	}
 	*pos = p;
 	return 1;
 }
