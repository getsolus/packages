Subject: [PATCH 2/5] include/common.h: Add macro to handle branch prediction
 hints

---
 include/common.h | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/include/common.h b/include/common.h
index 3aa88ca..6a964ab 100644
--- a/include/common.h
+++ b/include/common.h
@@ -36,6 +36,15 @@
 extern int errno;
 #endif
 
+/* Branch prediction hints for supported compilers */
+#ifdef __GNUC__
+#define IKS_LIKELY(x)   __builtin_expect (!!(x), 1)
+#define IKS_UNLIKELY(x) __builtin_expect (!!(x), 0)
+#else
+#define IKS_LIKELY(x)   (x)
+#define IKS_UNLIKELY(x) (x)
+#endif
+
 #include "finetune.h"
 
 #endif // __COMMON_H
